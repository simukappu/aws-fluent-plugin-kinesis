source 'https://rubygems.org'

# Specify your gem's dependencies in fluent-plugin-kinesis.gemspec
gemspec path: ".."

# Specify related gems for fluent-package v6.1.0
# https://github.com/fluent/fluent-package-builder/blob/master/CHANGELOG.md
# https://github.com/fluent/fluent-package-builder/blob/v6.1.0/fluent-package/config.rb#L10
gem "fluentd", "1.20.1"
# https://github.com/fluent/fluent-package-builder/blob/v6.1.0/fluent-package/Gemfile#L69-L79
gem "prometheus-client", "5.0.0"
gem "fluent-plugin-prometheus", "2.3.0"
gem "fluent-plugin-prometheus_pushgateway", "0.2.1"
gem "jmespath", "1.6.2"
gem "aws-partitions", "1.1298.0"
gem "aws-sdk-core", "3.260.0"
gem "aws-sdk-kms", "1.135.0"
gem "aws-sdk-sqs", "1.122.0"
gem "aws-sigv4", "1.12.1"
gem "aws-sdk-s3", "1.235.0"
gem "fluent-plugin-s3", "1.8.6"
